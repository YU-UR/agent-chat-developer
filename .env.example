# Compose project
COMPOSE_PROJECT_NAME=ai-chat-systerm

# Redis
REDIS_HOST=localhost
REDIS_IMAGE=redis:8.2
REDIS_PORT=6379

# Kafka - local development
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# PostgreSQL
POSTGRES_IMAGE=postgres:16
POSTGRES_PORT=5432
POSTGRES_DB=agent_chat
POSTGRES_USER=agent_chat
POSTGRES_PASSWORD=replace_with_local_password

# LangGraph checkpoint database
LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://agent_chat:replace_with_local_password@localhost:5432/agent_chat

# Application database
DATABASE_URL=postgresql+asyncpg://agent_chat:replace_with_local_password@localhost:5432/agent_chat

# Alembic migrations
ALEMBIC_DATABASE_URL=postgresql+psycopg://agent_chat:replace_with_local_password@localhost:5432/agent_chat

# Sandbox
SANDBOX_API_URL=http://127.0.0.1:8010
SANDBOX_HTTP_TIMEOUT_SECONDS=20

# Memory retrieval
MEMORY_SEARCH_TIMEOUT_SECONDS=60

# Local LLM API used by Mem0
MEMORY_LLM_BASE_URL=http://127.0.0.1:8020/v1

# Milvus vector database
MILVUS_URI=http://127.0.0.1:19530

# Frontend host port
FRONTEND_PORT=8080

# Linux deployment only:
# Replace with the group ID of /var/run/docker.sock on the server.
# Example command: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Persistent data directory for Linux deployment
AGENT_CHAT_DATA_DIR=/srv/agent-chat/data

# MinIO: replace with credentials generated for deployment
MINIO_ROOT_USER=replace_with_minio_user
MINIO_ROOT_PASSWORD=replace_with_strong_password